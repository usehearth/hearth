  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
