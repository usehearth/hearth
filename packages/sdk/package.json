{
  "name": "@hearth/sdk",
  "version": "0.1.0",
  "description": "Small typed client for a Hearth (ACP) server over WebSocket.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
